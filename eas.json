{
    "cli": {
        "version": ">= 16.7.0",
        "appVersionSource": "remote"
    },
    "build": {
        "development": {
            "developmentClient": true,
            "distribution": "internal",
            "environment": "development",
            "channel": "development",
            "env": {
                "APP_ENV": "development"
            }
        },
        "preview": {
            "distribution": "internal",
            "environment": "preview",
            "channel": "preview",
            "env": {
                "APP_ENV": "preview"
            }
        },
        "beta": {
            "distribution": "store",
            "environment": "production",
            "channel": "production",
            "autoIncrement": true,
            "env": {
                "APP_ENV": "beta"
            }
        },
        "production": {
            "autoIncrement": true,
            "environment": "production",
            "channel": "production",
            "env": {
                "APP_ENV": "production"
            }
        }
    },
    "submit": {
        "beta": {
            "ios": {
                "ascAppId": "6758940296",
                "ascApiKeyId": "8JL7FJ382G",
                "ascApiKeyIssuerId": "f760c90f-1b4f-4159-8c87-4e5d94fec3e1"
            },
            "android": {
                "track": "alpha"
            }
        },
        "production": {}
    }
}
