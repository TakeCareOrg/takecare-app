{
    "extends": "expo/tsconfig.base",
    "compilerOptions": {
        "strict": true,
        "jsx": "react-jsx",
        "paths": {
            "@app/*": ["./app/*"],
            "@components/*": ["./app/components/*"],
            "@layouts/*": ["./app/layouts/*"],
            "@hooks/*": ["./app/hooks/*"],
            "@navigation/*": ["./app/navigation/*"],
            "@screens/*": ["./app/screens/*"],
            "@utils/*": ["./app/utils/*"],
            "@constants/*": ["./app/constants/*"],
            "@config/*": ["./app/config/*"],
            "@assets/*": ["./app/assets/*"],
            "@types/*": ["./app/types/*"],
            "@dtypes/*": ["./app/types/*"],
            "@services/*": ["./app/services/*"],
            "@stores/*": ["./app/stores/*"],
            "@locales/*": ["./app/i18n/locales/*"],
            "@i18n/*": ["./app/i18n/*"],
            "@contexts/*": ["./app/contexts/*"]
        }
    },
    "include": ["**/*.ts", "**/*.tsx"]
}
